rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && request.resource.data.keys().hasOnly(['plan'])
        && request.resource.data.plan == 'free';
      // Plans are managed by a trusted backend when billing is introduced.
      allow update, delete: if false;
      match /saved_items/{itemId} {
        function valid(data) {
          return data.keys().hasAll(['userId', 'url', 'sharedText', 'title', 'thumbnailUrl',
              'platform', 'createdAt', 'updatedAt', 'clientCreatedAt', 'isFavorite'])
            && data.keys().hasOnly(['userId', 'url', 'sharedText', 'title', 'thumbnailUrl',
              'description', 'siteName', 'domain', 'metadataStatus',
              'platform', 'createdAt', 'updatedAt', 'clientCreatedAt', 'isFavorite',
              'tag', 'notes', 'hasReminder', 'reminderAt', 'repeatType',
              'customIntervalDays'])
            && data.userId == uid
            && data.url is string && data.url.size() <= 8192
            && (data.url == '' || data.url.matches('https?://[^\\s]+'))
            && (data.sharedText == null || (data.sharedText is string && data.sharedText.size() <= 20000))
            && (data.title == null || (data.title is string && data.title.size() <= 500))
            && (!data.keys().hasAny(['description']) || data.description == null
              || (data.description is string && data.description.size() <= 1000))
            && (data.thumbnailUrl == null || (data.thumbnailUrl is string && data.thumbnailUrl.size() <= 8192 && data.thumbnailUrl.matches('https://[^\\s]+')))
            && (!data.keys().hasAny(['siteName']) || data.siteName == null
              || (data.siteName is string && data.siteName.size() <= 500))
            && (!data.keys().hasAny(['domain']) || data.domain == null
              || (data.domain is string && data.domain.size() <= 253))
            && (!data.keys().hasAny(['metadataStatus'])
              || data.metadataStatus in ['pending', 'complete', 'unavailable'])
            && data.platform in ['tiktok', 'instagram', 'facebook', 'youtube', 'x', 'reddit', 'website']
            && data.isFavorite is bool
            && (!data.keys().hasAny(['tag']) || data.tag == null
              || (data.tag is string && data.tag.size() <= 100))
            && (!data.keys().hasAny(['notes']) || data.notes == null
              || (data.notes is string && data.notes.size() <= 5000))
            && (!data.keys().hasAny(['hasReminder']) || data.hasReminder is bool)
            && (!data.keys().hasAny(['reminderAt']) || data.reminderAt == null
              || data.reminderAt is timestamp)
            && (!data.keys().hasAny(['repeatType'])
              || data.repeatType in ['never', 'daily', 'weekly', 'monthly', 'custom'])
            && (!data.keys().hasAny(['customIntervalDays'])
              || data.customIntervalDays == null
              || (data.customIntervalDays is int && data.customIntervalDays >= 1
                && data.customIntervalDays <= 365))
            && data.createdAt is timestamp && data.updatedAt is timestamp
            && data.clientCreatedAt is timestamp;
        }
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && valid(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if owner(uid) && valid(request.resource.data)
          && resource.data.userId == uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isFavorite', 'title', 'description', 'thumbnailUrl', 'siteName',
            'domain', 'metadataStatus', 'tag', 'notes', 'hasReminder',
            'reminderAt', 'repeatType', 'customIntervalDays', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
      }
    }
  }
}
